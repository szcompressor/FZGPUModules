+            {
+                float4 tmp_buffer = reinterpret_cast<const float4*>(oriData)[i/4];
+                int sign_ofs = (int)(i % 32);
+
+                currQuant = quantization(tmp_buffer.x, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                absQ = abs(lorenQuant);
+                maxQuant = maxQuant > absQ ? maxQuant : absQ;
+                if (sign_ofs) maxQuan2 = maxQuan2 > absQ ? maxQuan2 : absQ;
+                else outlier = absQ;
