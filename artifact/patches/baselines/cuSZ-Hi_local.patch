@@ -28,6 +28,11 @@ struct psz_context {
   bool task_dryrun{false};
   bool task_experiment{false};
 
+  // In-process repeat count for -R time benchmarking (--repeat, default 1).
+  // Loops the compress/decompress task N times in one process so device timing
+  // reflects a warm CUDA context/clock state, not a fresh-process cold start.
+  int repeat{1};
