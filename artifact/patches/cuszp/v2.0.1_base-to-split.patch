+                currQuant = quantization(tmp_buffer.y, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                absQ = abs(lorenQuant);
+                maxQuant = maxQuant > absQ ? maxQuant : absQ;
+                maxQuan2 = maxQuan2 > absQ ? maxQuan2 : absQ;
