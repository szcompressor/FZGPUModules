+// ---------------------------------------------------------------------------
+// Split count -> scan -> pack compress pipeline (f32, plain + outlier).
+// K1 (count) and K2 (pack) below are flat, one-thread-per-32-element-block
+// kernels with no cross-thread dependency at all -- the exclusive prefix sum
+// that used to require a decoupled lookback is computed once, in between them,
+// by cub::DeviceScan over the header bytes K1 writes (see cuSZp_entry_f32.cu).
+// ---------------------------------------------------------------------------
+
+__global__ void cuSZp_count_kernel_plain_f32(const float* const __restrict__ oriData,
+                                              unsigned char* const __restrict__ cmpData,
+                                              const float eb, const size_t nbEle,
+                                              const size_t numHeaderBlocks)
+{
+    size_t gid = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (gid >= numHeaderBlocks) return;
+
+    const float recipPrecision = 0.5f/eb;
+    size_t base_block_start_idx = gid * 32;
+    size_t base_block_end_idx = base_block_start_idx + 32;
+
+    int maxQuant = 0;
+    if (base_block_start_idx < nbEle)
+    {
+        int prevQuant = 0;
+        int currQuant, lorenQuant;
+        if (base_block_end_idx < nbEle)
+        {
+            #pragma unroll 8
+            for (size_t i = base_block_start_idx; i < base_block_end_idx; i += 4)
+            {
+                float4 tmp_buffer = reinterpret_cast<const float4*>(oriData)[i/4];
+
+                currQuant = quantization(tmp_buffer.x, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                maxQuant = maxQuant > abs(lorenQuant) ? maxQuant : abs(lorenQuant);
+
+                currQuant = quantization(tmp_buffer.y, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                maxQuant = maxQuant > abs(lorenQuant) ? maxQuant : abs(lorenQuant);
+
+                currQuant = quantization(tmp_buffer.z, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                maxQuant = maxQuant > abs(lorenQuant) ? maxQuant : abs(lorenQuant);
+
+                currQuant = quantization(tmp_buffer.w, recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                maxQuant = maxQuant > abs(lorenQuant) ? maxQuant : abs(lorenQuant);
+            }
+        }
+        else
+        {
+            size_t remainbEle = nbEle - base_block_start_idx;
+            for (size_t i = base_block_start_idx; i < base_block_start_idx+remainbEle; i++)
+            {
+                currQuant = quantization(oriData[i], recipPrecision);
+                lorenQuant = currQuant - prevQuant; prevQuant = currQuant;
+                maxQuant = maxQuant > abs(lorenQuant) ? maxQuant : abs(lorenQuant);
+            }
+        }
+    }
+
+    cmpData[gid] = (unsigned char)get_bit_num((unsigned int)maxQuant);
+}
