+__global__ void cuSZp_count_kernel_outlier_f32(const float* const __restrict__ oriData,
+                                                unsigned char* const __restrict__ cmpData,
+                                                const float eb, const size_t nbEle,
+                                                const size_t numHeaderBlocks)
+{
+    size_t gid = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (gid >= numHeaderBlocks) return;
+
+    const float recipPrecision = 0.5f/eb;
+    size_t base_block_start_idx = gid * 32;
+    size_t base_block_end_idx = base_block_start_idx + 32;
+
+    int maxQuant = 0, maxQuan2 = 0, outlier = 0;
